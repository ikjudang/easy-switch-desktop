<?xml version="1.0" encoding="utf-8"?>
<!-- 이 PC의 사용자 NuGet 설정(%APPDATA%\NuGet\NuGet.Config)에는 패키지 원본이 비어 있다. 전역 설정을 건드리지 않고
     이 저장소에서만 nuget.org를 쓴다. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

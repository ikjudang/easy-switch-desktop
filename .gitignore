# User-facing build: track the executable and its accompanying documents only.
/build/*
!/build/EasySwitch-*.exe
!/build/EasySwitch-*-fast-win-*.zip
!/build/README.txt
!/build/SHA256SUMS.txt
!/build/status-codes.md
!/build/Assets/
/build/Assets/*
!/build/Assets/Licenses/
!/build/Assets/Licenses/*.txt

